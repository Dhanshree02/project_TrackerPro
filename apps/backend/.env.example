# ---- Database ----
# Connection string for EF Core / Npgsql. Overrides appsettings.json when set.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=trackerpro;Username=trackerpro;Password=trackerpro_dev

# ---- JWT (ALWAYS override SigningKey outside local dev) ----
Jwt__Issuer=TrackerPro
Jwt__Audience=TrackerPro.Client
Jwt__SigningKey=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS
Jwt__AccessTokenExpiryMinutes=30
Jwt__RefreshTokenExpiryDays=7

# ---- CORS ----
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:5173
