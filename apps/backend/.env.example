# ---- Local PostgreSQL on this machine ----
# Docker Compose stack: Host=localhost;Port=5432 (or Host=postgres_db from inside compose network)
# LAN / shared Docker on another machine: Host=10.50.30.189;Port=5432
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=trackerpro;Username=postgres;Password=clockit

# ---- JWT (ALWAYS override SigningKey outside local dev) ----
Jwt__Issuer=TrackerPro
Jwt__Audience=TrackerPro.Client
Jwt__SigningKey=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS
Jwt__AccessTokenExpiryMinutes=30
Jwt__RefreshTokenExpiryDays=7

# ---- CORS (add your LAN IP if BA opens the app at http://YOUR_IP:3000 without Docker proxy) ----
Cors__AllowedOrigins__0=http://localhost:6002
Cors__AllowedOrigins__1=http://127.0.0.1:6002
Cors__AllowedOrigins__2=http://localhost:6003
Cors__AllowedOrigins__3=http://localhost:3000
Cors__AllowedOrigins__4=http://10.50.30.189:3000
