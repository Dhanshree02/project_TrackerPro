# =========================================
# TrackerPro Frontend → Backend connection
# =========================================

# Base URL of the .NET API (apps/backend).
# LEAVE UNSET for Docker Compose / LAN demos — browser uses /api on the same host (works for
# http://YOUR_LAN_IP:3000). Vite proxies /api → backend inside compose.
# Set only for local `npm run dev` on the host (no Docker):
# VITE_API_URL=http://localhost:5194

# Vite dev-server proxy target for /api (local npm run). Docker Compose overrides this to http://backend:8080.
VITE_BACKEND_URL=http://localhost:5194
